# Copia este archivo a ".env" y rellena los valores. NO subas ".env" al repo.
# Lo lee docker compose (servicio api).

# --- Alpaca (datos reales) — las crea el dueño del servidor en https://alpaca.markets ---
Alpaca__ApiKeyId=
Alpaca__ApiSecretKey=

# --- Firebase Cloud Messaging (push remoto) ---
# El Project ID (ej. marketintel-a1746). La service-account va como archivo en ./secrets/fcm.json
Fcm__ProjectId=
