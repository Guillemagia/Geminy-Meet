<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Enables `dotnet user-secrets` so API keys stay out of the repo. -->
    <UserSecretsId>marketintel-api-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Google.Apis.Auth" Version="1.68.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarketIntel.Shared\MarketIntel.Shared.csproj" />
  </ItemGroup>

  <!-- Per-language string catalogs for backend-generated text (analysis, assistant…).
       The Web SDK claims **/*.json as Content by default, which suppresses embedding; remove
       them from Content first so they are embedded (read at runtime by Loc). -->
  <ItemGroup>
    <Content Remove="Localization\strings.*.json" />
    <!-- WithCulture=false is essential: without it MSBuild reads the ".en"/".es" in the file name
         as a culture and ships the JSON in a satellite assembly, so typeof(Loc).Assembly can't
         find it and every string falls back to its raw key. -->
    <EmbeddedResource Include="Localization\strings.*.json" WithCulture="false" />
  </ItemGroup>

  <!-- Runtime signal-registry JSON store must not be bundled as content. -->
  <ItemGroup>
    <Content Remove="data\**" />
  </ItemGroup>

</Project>
