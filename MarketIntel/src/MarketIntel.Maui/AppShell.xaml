<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MarketIntel.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:MarketIntel.Maui.Pages"
    xmlns:loc="clr-namespace:MarketIntel.Maui.Localization"
    Title="MarketIntel"
    FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="{loc:Translate Tab_Market}"
            ContentTemplate="{DataTemplate pages:DashboardPage}"
            Route="dashboard" />
        <ShellContent
            Title="{loc:Translate Tab_Portfolio}"
            ContentTemplate="{DataTemplate pages:PaperTradingPage}"
            Route="paper" />
    </TabBar>

</Shell>
