<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MarketIntel.Maui.ViewModels"
             xmlns:loc="clr-namespace:MarketIntel.Maui.Localization"
             x:Class="MarketIntel.Maui.Pages.AssistantPage"
             x:Name="AssistantRoot"
             x:DataType="vm:AssistantViewModel"
             Title="{Binding Title}"
             BackgroundColor="#0B1220">

    <Grid RowDefinitions="*,Auto,Auto" Padding="12">

        <!-- Messages -->
        <CollectionView Grid.Row="0" x:Name="MessagesView" ItemsSource="{Binding Messages}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatMessage">
                    <Grid Padding="0,4">
                        <Border BackgroundColor="{Binding IsUser, Converter={StaticResource BubbleColor}}"
                                HorizontalOptions="{Binding IsUser, Converter={StaticResource BubbleAlign}}"
                                Stroke="#1F2A3C" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                                Padding="12" MaximumWidthRequest="320">
                            <Label Text="{Binding Text}" TextColor="White" FontSize="13" LineBreakMode="WordWrap" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Suggestion chips -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,6">
            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Suggestions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Text="{Binding .}" FontSize="12" Padding="12,4"
                                BackgroundColor="#1E293B" TextColor="#CBD5E1"
                                Command="{Binding Source={x:Reference AssistantRoot}, Path=BindingContext.AskCommand}"
                                CommandParameter="{Binding .}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Input -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
            <Entry Grid.Column="0" Text="{Binding Input}" Placeholder="{loc:Translate Assistant_InputPlaceholder}"
                   TextColor="White" PlaceholderColor="#64748B" ReturnCommand="{Binding SendCommand}" />
            <Button Grid.Column="1" Text="{loc:Translate Assistant_Send}" Command="{Binding SendCommand}"
                    BackgroundColor="#2563EB" TextColor="White" FontSize="13" Padding="14,0" />
        </Grid>
    </Grid>
</ContentPage>
