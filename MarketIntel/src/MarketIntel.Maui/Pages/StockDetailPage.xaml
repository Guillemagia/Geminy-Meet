<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MarketIntel.Maui.ViewModels"
             xmlns:contracts="clr-namespace:MarketIntel.Shared.Contracts;assembly=MarketIntel.Shared"
             xmlns:loc="clr-namespace:MarketIntel.Maui.Localization"
             x:Class="MarketIntel.Maui.Pages.StockDetailPage"
             x:Name="DetailRoot"
             x:DataType="vm:StockDetailViewModel"
             Title="{Binding Symbol}"
             BackgroundColor="#0B1220">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{loc:Translate Detail_Paper}" Clicked="OnPaperTrade" />
        <ToolbarItem Text="{loc:Translate Detail_AI}" Clicked="OnAskAssistant" />
    </ContentPage.ToolbarItems>

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14" BindingContext="{Binding Signal}" x:DataType="contracts:SignalDto">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="{Binding Symbol}" TextColor="White" FontSize="30" FontAttributes="Bold" />
                        <Label Text="{Binding Price, StringFormat='{0:C2}'}" TextColor="#CBD5E1" FontSize="18" />
                        <Border BackgroundColor="{Binding Direction, Converter={StaticResource DirectionToColor}}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 6" HorizontalOptions="Start" Margin="0,4,0,0">
                            <Label Text="{Binding Direction, Converter={StaticResource DirectionToText}}"
                                   TextColor="White" FontSize="12" FontAttributes="Bold" Padding="10,3" />
                        </Border>
                    </VerticalStackLayout>
                    <Border Grid.Column="1" WidthRequest="72" HeightRequest="72"
                            BackgroundColor="{Binding Score, Converter={StaticResource ScoreToColor}}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 14" VerticalOptions="Start">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="-2">
                            <Label Text="{Binding Score}" TextColor="White" FontSize="30" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="/100" TextColor="White" FontSize="11" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label TextColor="#64748B" FontSize="12">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{loc:Translate Detail_ConfLabel}" TextColor="#64748B" />
                            <Span Text="{Binding Confidence, Converter={StaticResource ConfToText}}" TextColor="#CBD5E1" />
                            <Span Text="{loc:Translate Detail_DataQualityLabel}" TextColor="#64748B" />
                            <Span Text="{Binding DataQuality, StringFormat='{0}%'}" TextColor="#CBD5E1" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Event risk (earnings / macro) -->
                <Border IsVisible="{Binding EventRisk.Events.Count, Converter={StaticResource CountToBool}}"
                        BackgroundColor="#0F1A2E" StrokeThickness="1.5" StrokeShape="RoundRectangle 12"
                        Stroke="{Binding EventRisk.Level, Converter={StaticResource RiskToColor}}">
                    <VerticalStackLayout Padding="14" Spacing="6" BindingContext="{Binding EventRisk}" x:DataType="contracts:EventRiskDto">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="{loc:Translate Detail_EventRisk}" TextColor="#64748B" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                            <Border BackgroundColor="{Binding Level, Converter={StaticResource RiskToColor}}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 5">
                                <Label Text="{Binding Level, Converter={StaticResource RiskToText}}" TextColor="White" FontSize="10" FontAttributes="Bold" Padding="7,2" />
                            </Border>
                        </HorizontalStackLayout>
                        <Label Text="{Binding Message}" TextColor="#E2E8F0" FontSize="13" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Events}" Spacing="3" Margin="0,4,0,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="contracts:EconomicEventDto">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding Title}" TextColor="#CBD5E1" FontSize="12" />
                                        <Label Grid.Column="1" Text="{Binding HoursUntil, Converter={StaticResource HoursToWhen}}"
                                               TextColor="{Binding Importance, Converter={StaticResource ImportanceToColor}}"
                                               FontSize="12" FontAttributes="Bold" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- NO-TRADE banner -->
                <Border IsVisible="{Binding IsNoTrade}" BackgroundColor="#7F1D1D" StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Padding="14" Spacing="6">
                        <Label Text="{loc:Translate Detail_NoTrade}" TextColor="White" FontSize="15" FontAttributes="Bold" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding NoTradeReasons}" Spacing="2">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding ., StringFormat='• {0}'}" TextColor="#FECACA" FontSize="12" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Learned (stacked) ensemble: a meta-model learned the combination weights out-of-sample -->
                <Label Text="{loc:Translate Detail_LearnedEnsemble}" TextColor="#64748B" FontSize="11" FontAttributes="Bold"
                       IsVisible="{Binding LearnedEnsemble.Models.Count, Converter={StaticResource CountToBool}}" />
                <Border BackgroundColor="#111C2E" Stroke="#1F2A3C" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                        IsVisible="{Binding LearnedEnsemble.Models.Count, Converter={StaticResource CountToBool}}">
                    <VerticalStackLayout Padding="14" Spacing="10" BindingContext="{Binding LearnedEnsemble}" x:DataType="contracts:LearnedEnsembleDto">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" WidthRequest="64" HeightRequest="64"
                                    BackgroundColor="{Binding BullishProbability, Converter={StaticResource WinRateToColor}}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                <Label Text="{Binding BullishProbability, Converter={StaticResource ProbToPercent}}" TextColor="White" FontSize="20" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" Margin="12,0,0,0" VerticalOptions="Center">
                                <Label Text="{loc:Translate Learned_AccuracyLabel}" TextColor="#94A3B8" FontSize="12" />
                                <Label TextColor="#CBD5E1" FontSize="17" FontAttributes="Bold">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding OutOfSampleAccuracy, Converter={StaticResource ProbToPercent}}" />
                                            <Span Text="   " />
                                            <Span Text="{Binding Sample, Converter={StaticResource LocFmt}, ConverterParameter=Learned_SampleFmt}" TextColor="#475569" FontSize="11" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Models}" Spacing="8" Margin="0,4,0,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="contracts:ModelOpinionDto">
                                    <VerticalStackLayout Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <Label Grid.Column="0" Text="{Binding Name}" TextColor="#CBD5E1" FontSize="13" />
                                            <Label Grid.Column="1" TextColor="#64748B" FontSize="10" VerticalOptions="Center" Margin="0,0,10,0">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{loc:Translate Learned_WeightPrefix}" />
                                                        <Span Text="{Binding Weight, Converter={StaticResource ProbToPercent}}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label Grid.Column="2" Text="{Binding BullishProbability, Converter={StaticResource ProbToPercent}}"
                                                   TextColor="{Binding BullishProbability, Converter={StaticResource WinRateToColor}}"
                                                   FontSize="13" FontAttributes="Bold" />
                                        </Grid>
                                        <ProgressBar Progress="{Binding Weight}" ProgressColor="#8B5CF6" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="{Binding Note}" TextColor="#475569" FontSize="10" />
                    </VerticalStackLayout>
                </Border>

                <!-- Regime-conditional weighting: weights learned for the current local regime -->
                <Label Text="{loc:Translate Detail_RegimeWeighting}" TextColor="#64748B" FontSize="11" FontAttributes="Bold"
                       IsVisible="{Binding RegimeWeighting.Models.Count, Converter={StaticResource CountToBool}}" />
                <Border BackgroundColor="#111C2E" Stroke="#1F2A3C" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                        IsVisible="{Binding RegimeWeighting.Models.Count, Converter={StaticResource CountToBool}}">
                    <VerticalStackLayout Padding="14" Spacing="10" BindingContext="{Binding RegimeWeighting}" x:DataType="contracts:RegimeWeightingDto">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                <Label Text="{loc:Translate RegimeW_CurrentLabel}" TextColor="#64748B" FontSize="10" />
                                <Border BackgroundColor="#1E293B" StrokeThickness="0" StrokeShape="RoundRectangle 6" HorizontalOptions="Start" Padding="10,3" Margin="0,2,0,0">
                                    <Label Text="{Binding RegimeLabel}" TextColor="#C4B5FD" FontSize="15" FontAttributes="Bold" />
                                </Border>
                                <Label TextColor="#94A3B8" FontSize="11" Margin="0,6,0,0">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{loc:Translate RegimeW_AccuracyLabel}" />
                                            <Span Text="  " />
                                            <Span Text="{Binding OutOfSampleAccuracy, Converter={StaticResource ProbToPercent}}" TextColor="#CBD5E1" FontAttributes="Bold" />
                                            <Span Text="  " />
                                            <Span Text="{Binding Sample, Converter={StaticResource LocFmt}, ConverterParameter=Learned_SampleFmt}" TextColor="#475569" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                            <Border Grid.Column="1" WidthRequest="56" HeightRequest="56"
                                    BackgroundColor="{Binding BullishProbability, Converter={StaticResource WinRateToColor}}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                <Label Text="{Binding BullishProbability, Converter={StaticResource ProbToPercent}}" TextColor="White" FontSize="17" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Models}" Spacing="8" Margin="0,4,0,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="contracts:ModelOpinionDto">
                                    <VerticalStackLayout Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{Binding Name}" TextColor="#CBD5E1" FontSize="13" />
                                            <Label Grid.Column="1" TextColor="#64748B" FontSize="10" VerticalOptions="Center">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{loc:Translate Learned_WeightPrefix}" />
                                                        <Span Text="{Binding Weight, Converter={StaticResource ProbToPercent}}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </Grid>
                                        <ProgressBar Progress="{Binding Weight}" ProgressColor="#A855F7" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="{Binding Note}" TextColor="#475569" FontSize="10" />
                    </VerticalStackLayout>
                </Border>

                <!-- Signal quality (meta-model): grade + action + calibrated hit rate -->
                <Label Text="{loc:Translate Detail_Quality}" TextColor="#64748B" FontSize="11" FontAttributes="Bold"
                       IsVisible="{Binding Quality.Factors.Count, Converter={StaticResource CountToBool}}" />
                <Border BackgroundColor="#111C2E" Stroke="{Binding Quality.Grade, Converter={StaticResource GradeToColor}}" StrokeThickness="1.5" StrokeShape="RoundRectangle 12"
                        IsVisible="{Binding Quality.Factors.Count, Converter={StaticResource CountToBool}}">
                    <VerticalStackLayout Padding="14" Spacing="12" BindingContext="{Binding Quality}" x:DataType="contracts:SignalQualityDto">

                        <!-- Grade badge + action -->
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" WidthRequest="64" HeightRequest="64"
                                    BackgroundColor="{Binding Grade, Converter={StaticResource GradeToColor}}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                <Label Text="{Binding GradeLabel}" TextColor="White" FontSize="30" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" Margin="12,0,0,0" VerticalOptions="Center">
                                <Label Text="{Binding ActionLabel}" TextColor="White" FontSize="18" FontAttributes="Bold" />
                                <Label TextColor="#94A3B8" FontSize="12">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding QualityScore}" TextColor="#CBD5E1" FontAttributes="Bold" />
                                            <Span Text="{loc:Translate Quality_ScoreSuffix}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Raw model confidence shown NEXT TO the real historical hit rate (not rewritten) -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border Grid.Column="0" BackgroundColor="#0B1220" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10,8">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="{loc:Translate Quality_RawLabel}" TextColor="#64748B" FontSize="10" />
                                    <Label Text="{Binding RawConfidence, Converter={StaticResource ProbToPercent}}" TextColor="#CBD5E1" FontSize="17" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="#0B1220" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10,8">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="{loc:Translate Quality_CalLabel}" TextColor="#64748B" FontSize="10" />
                                    <Label Text="{Binding CalibratedHitRate, Converter={StaticResource ProbToPercent}}"
                                           TextColor="{Binding CalibratedHitRate, Converter={StaticResource WinRateToColor}}" FontSize="17" FontAttributes="Bold"
                                           IsVisible="{Binding CalibrationSample, Converter={StaticResource CountToBool}}" />
                                    <Label Text="{loc:Translate Quality_NoCal}" TextColor="#64748B" FontSize="14"
                                           IsVisible="{Binding CalibrationSample, Converter={StaticResource CountToBool}, ConverterParameter=invert}" />
                                    <Label Text="{Binding CalibrationSample, Converter={StaticResource LocFmt}, ConverterParameter=Quality_SampleFmt}"
                                           TextColor="#475569" FontSize="10"
                                           IsVisible="{Binding CalibrationSample, Converter={StaticResource CountToBool}}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Quality factors -->
                        <Label Text="{loc:Translate Quality_FactorsHeader}" TextColor="#64748B" FontSize="11" FontAttributes="Bold" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Factors}" Spacing="7">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="contracts:QualityFactorDto">
                                    <VerticalStackLayout Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{Binding Name}" TextColor="#CBD5E1" FontSize="13" />
                                            <Label Grid.Column="1" Text="{Binding Detail}" TextColor="#64748B" FontSize="10" VerticalOptions="Center" />
                                        </Grid>
                                        <ProgressBar Progress="{Binding Fraction}"
                                                     ProgressColor="{Binding Favorable, Converter={StaticResource FavorableToColor}}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="{loc:Translate Quality_CalNote}" TextColor="#475569" FontSize="10" />
                    </VerticalStackLayout>
                </Border>

                <!-- Ensemble / prediction engine -->
                <Label Text="{loc:Translate Detail_Ensemble}" TextColor="#64748B" FontSize="11" FontAttributes="Bold"
                       IsVisible="{Binding Ensemble.Models.Count, Converter={StaticResource CountToBool}}" />
                <Border BackgroundColor="#111C2E" Stroke="#1F2A3C" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                        IsVisible="{Binding Ensemble.Models.Count, Converter={StaticResource CountToBool}}">
                    <VerticalStackLayout Padding="14" Spacing="10" BindingContext="{Binding Ensemble}" x:DataType="contracts:EnsembleDto">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" WidthRequest="64" HeightRequest="64"
                                    BackgroundColor="{Binding Score, Converter={StaticResource ScoreToColor}}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                <Label Text="{Binding Score}" TextColor="White" FontSize="26" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" Margin="12,0,0,0" VerticalOptions="Center">
                                <Label Text="{loc:Translate Detail_ConsensusScore}" TextColor="#94A3B8" FontSize="12" />
                                <Label Text="{Binding Consensus}" TextColor="White" FontSize="17" FontAttributes="Bold" />
                                <Label TextColor="#64748B" FontSize="11">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding BullishProbability, Converter={StaticResource ProbToPercent}}" />
                                            <Span Text="{loc:Translate Detail_BullProbSuffix}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Models}" Spacing="8" Margin="0,4,0,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="contracts:ModelOpinionDto">
                                    <VerticalStackLayout Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <Label Grid.Column="0" Text="{Binding Name}" TextColor="#CBD5E1" FontSize="13" />
                                            <Label Grid.Column="1" TextColor="#64748B" FontSize="10" VerticalOptions="Center" Margin="0,0,10,0">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{loc:Translate Detail_ModelWeightPrefix}" />
                                                        <Span Text="{Binding Weight, Converter={StaticResource ProbToPercent}}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label Grid.Column="2" Text="{Binding BullishProbability, Converter={StaticResource ProbToPercent}}"
                                                   TextColor="{Binding BullishProbability, Converter={StaticResource WinRateToColor}}"
                                                   FontSize="13" FontAttributes="Bold" />
                                        </Grid>
                                        <ProgressBar Progress="{Binding BullishProbability}"
                                                     ProgressColor="{Binding BullishProbability, Converter={StaticResource WinRateToColor}}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ML model opinion -->
                <Label Text="{loc:Translate Detail_AISection}" TextColor="#64748B" FontSize="11" FontAttributes="Bold"
                       IsVisible="{Binding Ml.Sample, Converter={StaticResource CountToBool}}" />
                <Border BackgroundColor="#0F1A2E" Stroke="#1E3A8A" StrokeThickness="1.5" StrokeShape="RoundRectangle 12"
                        IsVisible="{Binding Ml.Sample, Converter={StaticResource CountToBool}}">
                    <VerticalStackLayout Padding="14" Spacing="8" BindingContext="{Binding Ml}" x:DataType="contracts:MlPredictionDto">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                <Label Text="{loc:Translate Detail_MlBullProb}" TextColor="#94A3B8" FontSize="12" />
                                <Label Text="{Binding BullishProbability, Converter={StaticResource ProbToPercent}}"
                                       TextColor="{Binding BullishProbability, Converter={StaticResource WinRateToColor}}"
                                       FontSize="30" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" HorizontalOptions="End" VerticalOptions="Center">
                                <Label Text="{loc:Translate Detail_MlAccuracy}" TextColor="#94A3B8" FontSize="11" HorizontalOptions="End" />
                                <Label Text="{Binding TestAccuracy, Converter={StaticResource ProbToPercent}}"
                                       TextColor="{Binding TestAccuracy, Converter={StaticResource WinRateToColor}}"
                                       FontSize="20" FontAttributes="Bold" HorizontalOptions="End" />
                                <Label Text="{Binding Sample, Converter={StaticResource LocFmt}, ConverterParameter=Detail_MlSample}" TextColor="#64748B" FontSize="10" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>
                        <Label FontSize="11" TextColor="#64748B">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding ModelName}" />
                                    <Span Text="{loc:Translate Detail_MlNote2}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <!-- Backtest (out-of-sample) -->
                <Label Text="{loc:Translate Detail_Backtest}" TextColor="#64748B" FontSize="11" FontAttributes="Bold"
                       IsVisible="{Binding Source={x:Reference DetailRoot}, Path=BindingContext.HasBacktest}" />
                <Border BackgroundColor="#111C2E" Stroke="#1F2A3C" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                        IsVisible="{Binding Source={x:Reference DetailRoot}, Path=BindingContext.HasBacktest}">
                    <VerticalStackLayout Padding="14" Spacing="10"
                                         BindingContext="{Binding Source={x:Reference DetailRoot}, Path=BindingContext.Backtest}"
                                         x:DataType="contracts:BacktestResultDto">
                        <Label Text="{Binding Trades, Converter={StaticResource LocFmt}, ConverterParameter=Detail_BacktestStrategy}" TextColor="#CBD5E1" FontSize="12" />
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                            <Label Grid.Row="0" Grid.Column="0" Text="{loc:Translate Detail_WinRate}" TextColor="#64748B" FontSize="11" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{loc:Translate Detail_ProfitFactor}" TextColor="#64748B" FontSize="11" />
                            <Label Grid.Row="0" Grid.Column="2" Text="{loc:Translate Detail_Sharpe}" TextColor="#64748B" FontSize="11" />
                            <Label Grid.Row="1" Grid.Column="0" Text="{Binding WinRate, Converter={StaticResource ProbToPercent}}"
                                   TextColor="{Binding WinRate, Converter={StaticResource WinRateToColor}}" FontSize="16" FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding ProfitFactor, StringFormat='{0:0.00}'}" TextColor="#CBD5E1" FontSize="16" FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="2" Text="{Binding Sharpe, StringFormat='{0:0.00}'}" TextColor="#CBD5E1" FontSize="16" FontAttributes="Bold" />
                            <Label Grid.Row="2" Grid.Column="0" Text="{loc:Translate Detail_MaxDrawdown}" TextColor="#64748B" FontSize="11" Margin="0,6,0,0" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{loc:Translate Detail_TotalReturn}" TextColor="#64748B" FontSize="11" Margin="0,6,0,0" />
                            <Label Grid.Row="2" Grid.Column="2" Text="{loc:Translate Detail_AvgWinLoss}" TextColor="#64748B" FontSize="11" Margin="0,6,0,0" />
                            <Label Grid.Row="3" Grid.Column="0" Text="{Binding MaxDrawdownPercent, StringFormat='-{0:0.0}%'}" TextColor="#F87171" FontSize="16" FontAttributes="Bold" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding TotalReturnPercent, StringFormat='{0:+0.0;-0.0}%'}"
                                   TextColor="{Binding TotalReturnPercent, Converter={StaticResource ContribToColor}}" FontSize="16" FontAttributes="Bold" />
                            <Label Grid.Row="3" Grid.Column="2" FontSize="14" FontAttributes="Bold" TextColor="#CBD5E1">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding AvgWinPercent, StringFormat='+{0:0.0}'}" />
                                        <Span Text=" / " />
                                        <Span Text="{Binding AvgLossPercent, StringFormat='{0:0.0}'}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>
                        <Label Text="{loc:Translate Detail_BacktestNote}"
                               TextColor="#64748B" FontSize="10" />
                    </VerticalStackLayout>
                </Border>

                <!-- Options -->
                <Label Text="{loc:Translate Detail_Options}" TextColor="#64748B" FontSize="11" FontAttributes="Bold"
                       IsVisible="{Binding Source={x:Reference DetailRoot}, Path=BindingContext.HasOptions}" />
                <Border BackgroundColor="#111C2E" Stroke="#1F2A3C" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                        IsVisible="{Binding Source={x:Reference DetailRoot}, Path=BindingContext.HasOptions}">
                    <VerticalStackLayout Padding="14" Spacing="12"
                                         BindingContext="{Binding Source={x:Reference DetailRoot}, Path=BindingContext.Options}"
                                         x:DataType="contracts:OptionsAnalysisDto">
                        <!-- Expected move -->
                        <VerticalStackLayout Spacing="1">
                            <Label Text="{loc:Translate Detail_ExpectedMove}" TextColor="#94A3B8" FontSize="12" />
                            <Label Text="{Binding ExpectedMoveLabel}" TextColor="#38BDF8" FontSize="20" FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <!-- Best contracts -->
                        <Label Text="{loc:Translate Detail_BestContracts}" TextColor="#64748B" FontSize="11" FontAttributes="Bold" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Best}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="contracts:OptionContractDto">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Grid.Column="0" BackgroundColor="{Binding Type, Converter={StaticResource OptionTypeToColor}}"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 6" VerticalOptions="Center">
                                            <Label Text="{Binding Type, Converter={StaticResource OptionTypeToText}}"
                                                   TextColor="White" FontSize="10" FontAttributes="Bold" Padding="8,3" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                                            <Label FontSize="14" FontAttributes="Bold" TextColor="White">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Strike, StringFormat='{0:0.##}'}" />
                                                        <Span Text="  ·  " TextColor="#64748B" />
                                                        <Span Text="{Binding Expiration}" TextColor="#94A3B8" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label FontSize="10" TextColor="#64748B">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Mid, StringFormat='mid {0:0.00}'}" />
                                                        <Span Text="{Binding Delta, StringFormat='  ·  Δ {0:0.00}'}" />
                                                        <Span Text="{Binding Iv, StringFormat='  ·  IV {0:P0}'}" />
                                                        <Span Text="{Binding Volume, StringFormat='  ·  vol {0}'}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2" WidthRequest="40" HeightRequest="40"
                                                BackgroundColor="{Binding QualityScore, Converter={StaticResource ScoreToColor}}"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 8" VerticalOptions="Center">
                                            <Label Text="{Binding QualityScore}" TextColor="White" FontSize="14" FontAttributes="Bold"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Unusual activity -->
                        <Label Text="{loc:Translate Detail_Unusual}" TextColor="#FBBF24" FontSize="11" FontAttributes="Bold"
                               IsVisible="{Binding Unusual.Count, Converter={StaticResource CountToBool}}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Unusual}" Spacing="6"
                                             IsVisible="{Binding Unusual.Count, Converter={StaticResource CountToBool}}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="contracts:OptionContractDto">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0" Text="{Binding Type, Converter={StaticResource OptionTypeToText}}"
                                               TextColor="{Binding Type, Converter={StaticResource OptionTypeToColor}}" FontSize="12" FontAttributes="Bold" />
                                        <Label Grid.Column="1" TextColor="#CBD5E1" FontSize="12" VerticalOptions="Center">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Strike, StringFormat='{0:0.##}'}" />
                                                    <Span Text="{Binding Expiration, StringFormat='  {0}'}" TextColor="#64748B" />
                                                    <Span Text="{Binding Volume, StringFormat='  ·  vol {0}'}" TextColor="#64748B" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label Grid.Column="2" Text="{Binding VolumeOiRatio, StringFormat='{0:0.0}x'}"
                                               TextColor="#FBBF24" FontSize="13" FontAttributes="Bold" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="{loc:Translate Detail_UnusualNote}"
                               TextColor="#64748B" FontSize="10"
                               IsVisible="{Binding Unusual.Count, Converter={StaticResource CountToBool}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- News -->
                <Label Text="{loc:Translate Detail_News}" TextColor="#64748B" FontSize="11" FontAttributes="Bold"
                       IsVisible="{Binding Source={x:Reference DetailRoot}, Path=BindingContext.HasNews}" />
                <Border BackgroundColor="#111C2E" Stroke="#1F2A3C" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                        IsVisible="{Binding Source={x:Reference DetailRoot}, Path=BindingContext.HasNews}">
                    <VerticalStackLayout Padding="14" Spacing="10"
                                         BindingContext="{Binding Source={x:Reference DetailRoot}, Path=BindingContext.News}"
                                         x:DataType="contracts:NewsAnalysisDto">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="{loc:Translate Detail_Sentiment}" TextColor="#94A3B8" FontSize="13" VerticalOptions="Center" />
                            <Border BackgroundColor="{Binding OverallSentiment, Converter={StaticResource SentimentToColor}}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 5">
                                <Label Text="{Binding OverallSentiment, Converter={StaticResource SentimentToText}}"
                                       TextColor="White" FontSize="11" FontAttributes="Bold" Padding="8,2" />
                            </Border>
                            <Label Text="{Binding Summary}" TextColor="#64748B" FontSize="11" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="contracts:NewsItemDto">
                                    <Grid ColumnDefinitions="4,*" ColumnSpacing="10">
                                        <BoxView Grid.Column="0" WidthRequest="4" CornerRadius="2"
                                                 Color="{Binding Sentiment, Converter={StaticResource SentimentToColor}}" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                                            <Label Text="{Binding Headline}" TextColor="#E2E8F0" FontSize="13" />
                                            <Label FontSize="10" TextColor="#64748B">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Source}" />
                                                        <Span Text="{Binding TimeAgo, StringFormat='  ·  {0}'}" />
                                                        <Span Text="  ·  " />
                                                        <Span Text="{Binding Sentiment, Converter={StaticResource SentimentToText}}"
                                                              TextColor="{Binding Sentiment, Converter={StaticResource SentimentToColor}}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="{loc:Translate Detail_NewsNote}"
                               TextColor="#64748B" FontSize="10" />
                    </VerticalStackLayout>
                </Border>

                <!-- Horizons -->
                <Label Text="{loc:Translate Detail_Horizons}" TextColor="#64748B" FontSize="11" FontAttributes="Bold" />
                <Border BackgroundColor="#111C2E" Stroke="#1F2A3C" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Padding="12" Spacing="12" BindableLayout.ItemsSource="{Binding Horizons}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="contracts:HorizonPredictionDto">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Label Grid.Column="0" Text="{Binding HorizonLabel}" TextColor="White" FontSize="14" FontAttributes="Bold" WidthRequest="70" />
                                        <Label Grid.Column="1" Text="{Binding BullishProbability, Converter={StaticResource ProbToPercent}}"
                                               TextColor="{Binding Direction, Converter={StaticResource DirectionToColor}}"
                                               FontSize="14" FontAttributes="Bold" HorizontalOptions="End" />
                                        <Label Grid.Column="2" Text="{Binding Confidence, StringFormat='  ({0})'}" TextColor="#64748B" FontSize="11" VerticalOptions="Center" />
                                    </Grid>
                                    <ProgressBar Progress="{Binding BullishProbability}"
                                                 ProgressColor="{Binding Direction, Converter={StaticResource DirectionToColor}}" />
                                    <Label FontSize="10" TextColor="#64748B">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{loc:Translate Detail_HBull}" /><Span Text="{Binding BullishProbability, Converter={StaticResource ProbToPercent}}" />
                                                <Span Text="{loc:Translate Detail_HBear}" /><Span Text="{Binding BearishProbability, Converter={StaticResource ProbToPercent}}" />
                                                <Span Text="{loc:Translate Detail_HNeutral}" /><Span Text="{Binding NeutralProbability, Converter={StaticResource ProbToPercent}}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- Indicators -->
                <Label Text="{loc:Translate Detail_Indicators}" TextColor="#64748B" FontSize="11" FontAttributes="Bold" />
                <Border BackgroundColor="#111C2E" Stroke="#1F2A3C" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Padding="12" Spacing="8" BindableLayout.ItemsSource="{Binding Indicators}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="contracts:IndicatorDto">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Label Grid.Column="0" Text="{Binding Name}" TextColor="#CBD5E1" FontSize="13" WidthRequest="110" />
                                    <Label Grid.Column="1" Text="{Binding Detail}" TextColor="#64748B" FontSize="11" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding Value}"
                                           TextColor="{Binding Bias, Converter={StaticResource BiasToColor}}"
                                           FontSize="13" FontAttributes="Bold" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- Price-action patterns (only when detected) -->
                <Label Text="{loc:Translate Detail_Patterns}" TextColor="#64748B" FontSize="11" FontAttributes="Bold"
                       IsVisible="{Binding Patterns.Count, Converter={StaticResource CountToBool}}" />
                <Border BackgroundColor="#111C2E" Stroke="#1F2A3C" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                        IsVisible="{Binding Patterns.Count, Converter={StaticResource CountToBool}}">
                    <VerticalStackLayout Padding="12" Spacing="10" BindableLayout.ItemsSource="{Binding Patterns}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="contracts:PatternDto">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                                        <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold"
                                               TextColor="{Binding Bias, Converter={StaticResource BiasToColor}}" />
                                        <Label Text="{Binding Detail}" TextColor="#64748B" FontSize="11" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="-2" VerticalOptions="Center" HorizontalOptions="End">
                                        <Label Text="{Binding HistoricalWinRate, Converter={StaticResource ProbToPercent}}"
                                               TextColor="{Binding HistoricalWinRate, Converter={StaticResource WinRateToColor}}"
                                               FontSize="18" FontAttributes="Bold" HorizontalOptions="End" />
                                        <Label Text="{Binding Sample, StringFormat='n={0}'}" TextColor="#64748B" FontSize="10" HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- Score breakdown -->
                <Label Text="{loc:Translate Detail_WhySignal}" TextColor="#64748B" FontSize="11" FontAttributes="Bold" />
                <Border BackgroundColor="#111C2E" Stroke="#1F2A3C" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Padding="12" Spacing="8" BindableLayout.ItemsSource="{Binding ScoreBreakdown}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="contracts:ScoreComponentDto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                                        <Label Text="{Binding Name}" TextColor="#CBD5E1" FontSize="13" />
                                        <Label Text="{Binding Detail}" TextColor="#64748B" FontSize="10" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" TextColor="{Binding Contribution, Converter={StaticResource ContribToColor}}"
                                           FontSize="14" FontAttributes="Bold" VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Contribution, StringFormat='{0:+0.0;-0.0;0}'}" />
                                                <Span Text="{Binding MaxContribution, StringFormat=' / {0:0}'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- Scenarios -->
                <Label Text="{loc:Translate Detail_Scenarios}" TextColor="#64748B" FontSize="11" FontAttributes="Bold" />
                <Border BackgroundColor="#111C2E" Stroke="#1F2A3C" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Padding="12" Spacing="10" BindableLayout.ItemsSource="{Binding Scenarios}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="contracts:ScenarioDto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                                        <Label Text="{Binding Name}" TextColor="White" FontSize="13" FontAttributes="Bold" />
                                        <Label Text="{Binding Description}" TextColor="#64748B" FontSize="11" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Probability, Converter={StaticResource ProbToPercent}}"
                                           TextColor="#CBD5E1" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- Market structure -->
                <Label Text="{loc:Translate Detail_Structure}" TextColor="#64748B" FontSize="11" FontAttributes="Bold"
                       IsVisible="{Binding Structure.Swings.Count, Converter={StaticResource CountToBool}}" />
                <Border BackgroundColor="#111C2E" Stroke="#1F2A3C" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                        IsVisible="{Binding Structure.Swings.Count, Converter={StaticResource CountToBool}}">
                    <VerticalStackLayout Padding="14" Spacing="8" BindingContext="{Binding Structure}" x:DataType="contracts:MarketStructureDto">
                        <Label Text="{Binding Trend}" FontSize="18" FontAttributes="Bold"
                               TextColor="{Binding Trend, Converter={StaticResource TrendToColor}}" />
                        <Label Text="{Binding Description}" TextColor="#94A3B8" FontSize="12" />
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,4,0,0">
                            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Swings}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="contracts:SwingPointDto">
                                        <Border BackgroundColor="#0B1220" StrokeThickness="1" StrokeShape="RoundRectangle 8"
                                                Stroke="{Binding Label, Converter={StaticResource SwingLabelToColor}}" Padding="10,6">
                                            <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                                <Label Text="{Binding Label, Converter={StaticResource SwingLabelToText}}"
                                                       TextColor="{Binding Label, Converter={StaticResource SwingLabelToColor}}"
                                                       FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" />
                                                <Label Text="{Binding Price, StringFormat='{0:0.00}'}" TextColor="#94A3B8" FontSize="11" HorizontalOptions="Center" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <!-- Support / Resistance zones -->
                <Label Text="{loc:Translate Detail_SupportResistance}" TextColor="#64748B" FontSize="11" FontAttributes="Bold"
                       IsVisible="{Binding Levels.Count, Converter={StaticResource CountToBool}}" />
                <Border BackgroundColor="#111C2E" Stroke="#1F2A3C" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                        IsVisible="{Binding Levels.Count, Converter={StaticResource CountToBool}}">
                    <VerticalStackLayout Padding="12" Spacing="8" BindableLayout.ItemsSource="{Binding Levels}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="contracts:PriceZoneDto">
                                <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="10">
                                    <BoxView Grid.Column="0" WidthRequest="4" CornerRadius="2"
                                             Color="{Binding Kind, Converter={StaticResource ZoneKindToColor}}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                        <Label FontSize="14" FontAttributes="Bold"
                                               TextColor="{Binding Kind, Converter={StaticResource ZoneKindToColor}}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Low, StringFormat='{0:0.00}'}" />
                                                    <Span Text=" – " />
                                                    <Span Text="{Binding High, StringFormat='{0:0.00}'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label FontSize="10" TextColor="#64748B">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Label}" />
                                                    <Span Text="   " />
                                                    <Span Text="{Binding Strength, Converter={StaticResource StrengthToDots}}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" VerticalOptions="Center" FontSize="13" FontAttributes="Bold"
                                           TextColor="#94A3B8"
                                           Text="{Binding DistancePercent, StringFormat='{0:+0.0;-0.0}%'}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- Risk -->
                <Label Text="{loc:Translate Detail_RiskMgmt}" TextColor="#64748B" FontSize="11" FontAttributes="Bold" />
                <Border BackgroundColor="#111C2E" Stroke="#1F2A3C" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Padding="14" Spacing="8" BindingContext="{Binding Risk}" x:DataType="contracts:RiskDto">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="{loc:Translate Detail_RiskLevelLabel}" TextColor="#94A3B8" FontSize="13" VerticalOptions="Center" />
                            <Border BackgroundColor="{Binding Level, Converter={StaticResource RiskToColor}}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 5">
                                <Label Text="{Binding Level, Converter={StaticResource RiskToText}}" TextColor="White" FontSize="11" FontAttributes="Bold" Padding="8,2" />
                            </Border>
                        </HorizontalStackLayout>
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                            <Label Grid.Row="0" Grid.Column="0" Text="{loc:Translate Detail_Stop}" TextColor="#64748B" FontSize="11" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{loc:Translate Detail_Target}" TextColor="#64748B" FontSize="11" />
                            <Label Grid.Row="0" Grid.Column="2" Text="{loc:Translate Detail_RR}" TextColor="#64748B" FontSize="11" />
                            <Label Grid.Row="1" Grid.Column="0" Text="{Binding SuggestedStop, StringFormat='{0:0.00}', TargetNullValue='—'}" TextColor="#F87171" FontSize="15" FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding SuggestedTarget, StringFormat='{0:0.00}', TargetNullValue='—'}" TextColor="#4ADE80" FontSize="15" FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="2" Text="{Binding RiskReward, StringFormat='{0:0.0}:1', TargetNullValue='—'}" TextColor="#CBD5E1" FontSize="15" FontAttributes="Bold" />
                        </Grid>
                        <Label Text="{Binding Note}" TextColor="#64748B" FontSize="11" />
                    </VerticalStackLayout>
                </Border>

                <!-- Explanation -->
                <Border BackgroundColor="#0F1A2E" Stroke="#1F2A3C" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Padding="14" Spacing="6">
                        <Label Text="🧠 ANÁLISIS" TextColor="#64748B" FontSize="11" FontAttributes="Bold" />
                        <Label Text="{Binding Explanation}" TextColor="#CBD5E1" FontSize="13" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
